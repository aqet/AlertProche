{
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/custom-sw.js",
          "/*.css",
          "/*.js",
          "/i18n/*.json"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2|ico|mp3|wav|ogg)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-feed",
      "urls": ["/feed**"],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "5s",
        "maxSize": 50,
        "maxAge": "3d",
        "refreshAhead": "1h"
      }
    },
    {
      "name": "api-posts",
      "urls": ["/posts**"],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "5s",
        "maxSize": 100,
        "maxAge": "3d",
        "refreshAhead": "1h"
      }
    }
  ]
}
